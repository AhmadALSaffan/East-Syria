<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: The map is a working surface: search, a category rail, and a readout
    that says exactly how much of the catalog you are looking at, floating over
    the full-bleed map. Selecting a place reads as one card.
  OWN-WORLD: Warm canvas, ivory type, terracotta pins and actions, wayfinding
    teal for "where am I" and nothing else. Controls are near-opaque pills with
    a hairline, so they hold contrast over any tile.
  STORY: You search or filter, the readout confirms what is on the map, and a
    tapped pin opens a card that leads to the place.
  FIRST VIEWPORT: Full-bleed dark map; back chip and search pill pinned at the
    top with the category rail and readout beneath; controls at the right.
  FORM: Same world as home; user-pinned direction (no roll).
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============================ instruments ============================ -->

    <LinearLayout
        android:id="@+id/topArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/search_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/ivory" />

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/terracotta_soft" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/map_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ivory"
                    android:textColorHint="@color/ivory_mute"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnFilter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/map_filters"
                    android:padding="12dp"
                    android:src="@drawable/ic_filter_list"
                    app:tint="@color/terracotta_soft" />

            </LinearLayout>

        </LinearLayout>

        <!-- Chips are built from the catalog's own categories at runtime. -->
        <HorizontalScrollView
            android:id="@+id/filterScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tvReadout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_readout"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/map_readout_loading"
                android:textColor="@color/ivory_dim"
                android:textSize="12sp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/mapProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:indeterminate="true"
                app:indicatorColor="@color/terracotta"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================== controls ============================= -->

    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/landmarkBottomCard"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_instrument_group"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/fabLayers"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_layers"
                android:padding="13dp"
                android:src="@drawable/ic_layers"
                app:tint="@color/ivory_dim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <ImageButton
                android:id="@+id/fabZoomIn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_zoom_in"
                android:padding="13dp"
                android:src="@drawable/ic_add"
                app:tint="@color/ivory_dim" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <ImageButton
                android:id="@+id/fabZoomOut"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_zoom_out"
                android:padding="13dp"
                android:src="@drawable/ic_remove"
                app:tint="@color/ivory_dim" />

        </LinearLayout>

        <!-- Where am I: the one red control on the map. -->
        <ImageButton
            android:id="@+id/fabMyLocation"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_accent"
            android:contentDescription="@string/map_my_location"
            android:elevation="4dp"
            android:padding="14dp"
            android:src="@drawable/ic_my_location"
            app:tint="@color/on_accent" />

    </LinearLayout>

    <!-- ========================== selected landmark ======================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/landmarkBottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/ripple"
        app:strokeColor="@color/line"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imageCardSmall"
                android:layout_width="84dp"
                android:layout_height="84dp"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivLandmarkSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_dark" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLandmarkTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/ivory"
                    android:textSize="17sp"
                    tools:text="Dura-Europos" />

                <TextView
                    android:id="@+id/tvLandmarkDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/ivory_dim"
                    android:textSize="13sp"
                    tools:text="Hellenistic, Parthian and Roman border city." />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:drawablePadding="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/terracotta_soft"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="@color/terracotta_soft"
                    tools:text="12.4 km away" />

            </LinearLayout>

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_accent"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/on_accent" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
