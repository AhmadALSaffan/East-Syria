<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile, v3. Who you are (photo, name, where from), three facts in quiet
  tiles, the places you saved as a photo rail, then grouped account rows:
  personal details, settings, language, about, privacy. Sign out sits apart.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.example.eastsyria.Ui.ScreenHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerTitle="@string/profile_title"
            app:showBack="false" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/profileContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="136dp">

                    <!-- ============================== identity ============================== -->

                    <LinearLayout
                        android:id="@+id/layoutIdentity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="24dp">

                        <FrameLayout
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:background="@drawable/bg_avatar_ring">

                            <ImageView
                                android:id="@+id/imgProfile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="4dp"
                                android:contentDescription="@string/profile_edit"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_profile_placeholder" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/amiri"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/ivory"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            tools:text="Ahmad Al Saffan" />

                        <TextView
                            android:id="@+id/tvLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:textColor="@color/ivory_dim"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_location"
                            app:drawableTint="@color/terracotta_soft"
                            tools:text="Explorer from Deir ez-Zor" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:orientation="horizontal">

                            <LinearLayout style="@style/Widget.EastSyria.V3.StatTile">

                                <TextView
                                    android:id="@+id/tvFactSaved"
                                    style="@style/Widget.EastSyria.V3.StatValue"
                                    tools:text="3" />

                                <TextView
                                    style="@style/Widget.EastSyria.V3.StatLabel"
                                    android:text="@string/profile_fact_saved" />

                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.EastSyria.V3.StatTile"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:id="@+id/tvFactKinds"
                                    style="@style/Widget.EastSyria.V3.StatValue"
                                    tools:text="2" />

                                <TextView
                                    style="@style/Widget.EastSyria.V3.StatLabel"
                                    android:text="@string/profile_fact_kinds" />

                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.EastSyria.V3.StatTile"
                                android:layout_marginStart="10dp">

                                <TextView
                                    android:id="@+id/tvFactSince"
                                    style="@style/Widget.EastSyria.V3.StatValue"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:textSize="16sp"
                                    tools:text="Aug 2026" />

                                <TextView
                                    style="@style/Widget.EastSyria.V3.StatLabel"
                                    android:text="@string/profile_fact_since" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/identitySkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_skeleton_block"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/identityError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_group"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/profile_error"
                            android:textColor="@color/ivory_dim"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/btnIdentityRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_chip_outline"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="@string/action_retry"
                            android:textColor="@color/ivory"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- =============================== saved =============================== -->

                    <LinearLayout style="@style/Widget.EastSyria.V3.SectionHeader">

                        <TextView
                            style="@style/Widget.EastSyria.V3.SectionTitle"
                            android:text="@string/profile_stamps" />

                        <TextView
                            android:id="@+id/tvSavedCount"
                            style="@style/Widget.EastSyria.V3.SectionMeta"
                            android:visibility="gone"
                            tools:text="3 kept"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvSavedAll"
                            style="@style/Widget.EastSyria.V3.SectionAction"
                            android:text="@string/profile_saved_all"
                            android:visibility="gone"
                            tools:visibility="visible" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSavedStamps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp"
                        android:visibility="gone"
                        tools:listitem="@layout/item_saved_stamp"
                        tools:orientation="horizontal"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/stampsSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:importantForAccessibility="no"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="148dp"
                            android:layout_height="196dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_skeleton_block" />

                        <View
                            android:layout_width="148dp"
                            android:layout_height="196dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_skeleton_block" />

                        <View
                            android:layout_width="148dp"
                            android:layout_height="196dp"
                            android:background="@drawable/bg_skeleton_block" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSavedEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_group"
                        android:drawablePadding="14dp"
                        android:gravity="center_vertical"
                        android:lineSpacingMultiplier="1.15"
                        android:padding="18dp"
                        android:text="@string/profile_saved_empty"
                        android:textColor="@color/ivory_dim"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_bookmark_border"
                        app:drawableTint="@color/terracotta_soft" />

                    <!-- =============================== account =============================== -->

                    <TextView
                        style="@style/Widget.EastSyria.V3.GroupLabel"
                        android:layout_marginTop="32dp"
                        android:text="@string/profile_account" />

                    <LinearLayout style="@style/Widget.EastSyria.V3.Group">

                        <LinearLayout
                            android:id="@+id/layoutPersonalDetails"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_person" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/profile_personal" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                        <View style="@style/Widget.EastSyria.V3.RowDivider" />

                        <LinearLayout
                            android:id="@+id/layoutSecurity"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_lock" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/security_title" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                        <View style="@style/Widget.EastSyria.V3.RowDivider" />

                        <LinearLayout
                            android:id="@+id/layoutLanguage"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_globe" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/settings_language" />

                            <TextView
                                android:id="@+id/tvLanguageValue"
                                style="@style/Widget.EastSyria.V3.RowValue"
                                tools:text="English" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                        <View style="@style/Widget.EastSyria.V3.RowDivider" />

                        <LinearLayout
                            android:id="@+id/layoutSettings"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_settings_menu" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/profile_settings" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        style="@style/Widget.EastSyria.V3.GroupLabel"
                        android:text="@string/profile_more" />

                    <LinearLayout style="@style/Widget.EastSyria.V3.Group">

                        <LinearLayout
                            android:id="@+id/layoutAbout"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_info" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/profile_about" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                        <View style="@style/Widget.EastSyria.V3.RowDivider" />

                        <LinearLayout
                            android:id="@+id/layoutPrivacy"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_privacy" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:text="@string/profile_privacy" />

                            <ImageView style="@style/Widget.EastSyria.V3.RowChevron" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.EastSyria.V3.Group"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:id="@+id/btnSignOut"
                            style="@style/Widget.EastSyria.V3.Row">

                            <ImageView
                                style="@style/Widget.EastSyria.V3.RowIcon"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/terracotta_soft" />

                            <TextView
                                style="@style/Widget.EastSyria.V3.RowLabel"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/profile_sign_out"
                                android:textColor="@color/terracotta_soft" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:textColor="@color/ivory_mute"
                        android:textSize="12sp"
                        tools:text="Version 1.0" />

                </LinearLayout>

            </ScrollView>

            <com.example.eastsyria.Ui.StatePanel
                android:id="@+id/statePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/canvas" />

        </FrameLayout>

    </LinearLayout>

    <com.example.eastsyria.Nav.NavDock
        android:id="@+id/navDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
