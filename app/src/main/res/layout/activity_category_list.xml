<?xml version="1.0" encoding="utf-8"?>
<!--
  A category's places, best-rated first. The same dense row as search and
  saved, with the description and a bookmark. Filters live in a sheet; when one
  is active the count line says so and offers to reset it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.example.eastsyria.Ui.ScreenHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/categories_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ivory_mute"
            android:textSize="14sp"
            tools:text="8 places" />

        <TextView
            android:id="@+id/btnResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="@string/category_reset_filters"
            android:textColor="@color/terracotta_soft"
            android:textSize="14sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:listitem="@layout/item_search_result" />

        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

        </LinearLayout>

        <com.example.eastsyria.Ui.StatePanel
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
