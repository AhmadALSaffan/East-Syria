<?xml version="1.0" encoding="utf-8"?>
<!--
  Curator dashboard: the catalog at a glance, then the catalog itself. Three
  figures, the two actions an administrator takes most, and every landmark with
  its status and its edit and delete controls. Nothing here leads nowhere.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.example.eastsyria.Ui.ScreenHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/admin_title"
        app:showBack="false" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/adminContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ============================== figures ============================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvLandmarksCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiri"
                            android:includeFontPadding="false"
                            android:lineHeight="40sp"
                            android:text="@string/admin_figure_unknown"
                            android:textColor="@color/ivory"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_stat_landmarks"
                            android:textColor="@color/ivory_mute"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvActiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiri"
                            android:includeFontPadding="false"
                            android:lineHeight="40sp"
                            android:text="@string/admin_figure_unknown"
                            android:textColor="@color/ivory"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_stat_published"
                            android:textColor="@color/ivory_mute"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tvPendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiri"
                            android:includeFontPadding="false"
                            android:lineHeight="40sp"
                            android:text="@string/admin_figure_unknown"
                            android:textColor="@color/gold"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_stat_pending"
                            android:textColor="@color/ivory_mute"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- =============================== actions ============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddLandmark"
                    style="@style/Widget.EastSyria.Button.Pill"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/admin_add_landmark"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconSize="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reportsBtn"
                    style="@style/Widget.EastSyria.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="@string/admin_reports"
                    android:textColor="@color/terracotta_soft"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_reports"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/terracotta_soft"
                    app:strokeColor="@color/line" />

            </LinearLayout>

            <!-- ============================= the catalog ============================ -->

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/terracotta_soft" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/admin_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/ivory"
                    android:textColorHint="@color/ivory_mute"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvShowingCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/ivory_mute"
                android:textSize="14sp"
                tools:text="12 landmarks" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLandmarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:itemCount="3"
                tools:listitem="@layout/item_admin_landmark" />

            <LinearLayout
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <include layout="@layout/item_search_skeleton" />

                <include layout="@layout/item_search_skeleton" />

                <include layout="@layout/item_search_skeleton" />

            </LinearLayout>

            <com.example.eastsyria.Ui.StatePanel
                android:id="@+id/statePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="32dp"
                android:paddingBottom="32dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
