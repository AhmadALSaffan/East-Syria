<?xml version="1.0" encoding="utf-8"?>
<!--
  One stop of the onboarding. A real photograph from the catalog fills the top
  two thirds and melts into the canvas; a piece of drawn art sits over it (an
  arch, a name plate, a route, a stamp) and moves at its own speed; the title
  and the sentence under it sit on the canvas.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/photoBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.62" />

    <FrameLayout
        android:id="@+id/photoFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="@id/photoBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/layerPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:scaleX="1.35"
            android:scaleY="1.35"
            tools:src="@drawable/onb_palmyra" />

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_canvas_top"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_canvas_bottom"
            android:importantForAccessibility="no" />

        <ImageView
            android:id="@+id/layerArt"
            android:layout_width="300dp"
            android:layout_height="390dp"
            android:layout_gravity="top|center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@drawable/art_onb_arch"
            tools:visibility="visible" />

        <!-- The wall label: a landmark's name in both scripts, exactly as the catalog holds it. -->
        <LinearLayout
            android:id="@+id/plate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="76dp"
            android:background="@drawable/bg_onb_plate"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="26dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiri"
                android:includeFontPadding="false"
                android:lineHeight="34sp"
                android:text="@string/onboarding_plate_en"
                android:textColor="@color/ivory"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/amiri"
                android:includeFontPadding="false"
                android:lineHeight="32sp"
                android:text="@string/onboarding_plate_ar"
                android:textColor="@color/ivory_dim"
                android:textDirection="rtl"
                android:textSize="26sp" />

            <View
                android:layout_width="36dp"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/onboarding_plate_place"
                android:textColor="@color/ivory_dim"
                android:textSize="13sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- A short rule with an eight-pointed star in it: where the picture ends and the words begin. -->
    <LinearLayout
        android:id="@+id/ornament"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/photoBottom">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/art_onb_star" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@color/line" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="28dp"
        android:textAppearance="@style/TextAppearance.EastSyria.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ornament"
        tools:text="Syria, from a distance" />

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="28dp"
        android:lineSpacingExtra="6dp"
        android:textColor="@color/ivory_dim"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        tools:text="Fortresses, rivers, museums, kitchens and workshops." />

</androidx.constraintlayout.widget.ConstraintLayout>
