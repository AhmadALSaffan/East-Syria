<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of the record. Inflated per fact; a fact with no value is never
  inflated at all, so the register never prints "N/A". The icon is optional and
  used for the practical facts (hours, entry, best time).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="top"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/ivRecordIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:visibility="gone"
            app:tint="@color/terracotta_soft"
            tools:src="@drawable/ic_clock"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvRecordLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ivory_mute"
            android:textSize="14sp"
            tools:text="Elevation" />

        <TextView
            android:id="@+id/tvRecordValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1.4"
            android:gravity="end"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/ivory"
            android:textSize="15sp"
            tools:text="244 m" />

    </LinearLayout>

    <View
        android:id="@+id/recordDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

</LinearLayout>
