<?xml version="1.0" encoding="utf-8"?>
<!--
  Reports: what the catalog and its readers actually did, counted from the
  records. Every number here is derived from createdAt, status or rating; there
  are no estimates, and no figure is shown that the data cannot produce.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <com.example.eastsyria.Ui.ScreenHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/reports_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollReports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/reportsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/ivory_mute"
                    android:textSize="13sp"
                    tools:text="Updated 2:15 PM" />

                <!-- ============================ period ============================ -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_segment_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnDaily"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/reports_day"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnWeekly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/reports_week"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnMonthly"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/reports_month"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- ============================ figures =========================== -->

                <LinearLayout
                    android:id="@+id/figuresGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="24dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/line"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="20dp">

                                    <TextView
                                        android:id="@+id/tvTotalLandmarks"
                                        style="@style/TextAppearance.EastSyria.Figure"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="8" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/admin_stat_landmarks"
                                        android:textColor="@color/ivory_dim"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/tvLandmarksGrowth"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/terracotta_soft"
                                        android:textSize="13sp"
                                        tools:text="+2 this week" />

                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/line" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="20dp">

                                    <TextView
                                        android:id="@+id/tvTotalUsers"
                                        style="@style/TextAppearance.EastSyria.Figure"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="14" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/reports_users"
                                        android:textColor="@color/ivory_dim"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/tvUsersGrowth"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/terracotta_soft"
                                        android:textSize="13sp"
                                        tools:text="+3 this week" />

                                </LinearLayout>

                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/line" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="20dp">

                                    <TextView
                                        android:id="@+id/tvPublished"
                                        style="@style/TextAppearance.EastSyria.Figure"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="8" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/admin_stat_published"
                                        android:textColor="@color/ivory_dim"
                                        android:textSize="14sp" />

                                </LinearLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/line" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:padding="20dp">

                                    <TextView
                                        android:id="@+id/tvPending"
                                        style="@style/TextAppearance.EastSyria.Figure"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/gold"
                                        tools:text="0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/admin_stat_pending"
                                        android:textColor="@color/ivory_dim"
                                        android:textSize="14sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- ============================= chart ============================ -->

                    <LinearLayout
                        style="@style/Widget.EastSyria.HomeSectionHeader"
                        android:layout_marginTop="32dp">

                        <TextView
                            style="@style/Widget.EastSyria.HomeSectionTitle"
                            android:text="@string/reports_chart_title" />

                        <View
                            style="@style/Widget.EastSyria.HomeSectionRule"
                            android:layout_marginEnd="0dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="24dp"
                        android:text="@string/reports_chart_caption"
                        android:textColor="@color/ivory_mute"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="24dp">

                        <com.example.eastsyria.Admin.Reports.EngagementChartView
                            android:id="@+id/engagementChartView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/tvChartEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/reports_chart_empty"
                            android:textColor="@color/ivory_mute"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </FrameLayout>

                    <!-- ============================ top rated ========================= -->

                    <LinearLayout
                        style="@style/Widget.EastSyria.HomeSectionHeader"
                        android:layout_marginTop="32dp">

                        <TextView
                            style="@style/Widget.EastSyria.HomeSectionTitle"
                            android:text="@string/reports_top_rated" />

                        <View
                            style="@style/Widget.EastSyria.HomeSectionRule"
                            android:layout_marginEnd="0dp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPopularLandmarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_popular_landmark" />

                    <TextView
                        android:id="@+id/tvTopRatedEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="24dp"
                        android:text="@string/reports_top_rated_empty"
                        android:textColor="@color/ivory_dim"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Loading: the figures card and the chart, breathing. -->
                <LinearLayout
                    android:id="@+id/loadingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/bg_skeleton_block" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="32dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/bg_skeleton_block" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <com.example.eastsyria.Ui.StatePanel
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/canvas" />

    </FrameLayout>

</LinearLayout>
