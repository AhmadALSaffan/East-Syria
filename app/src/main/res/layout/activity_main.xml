<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: First run is an approach to a place, not a feature tour. It refuses
    the swipeable benefit-card carousel every app in this category ships.
  OWN-WORLD: Basalt canvas, three tonal steps, no shadows. Clay acts, amber
    appears once and only at the threshold. Drawn geometry, never photography.
    Serif for titles, Roboto for everything the interface says.
  STORY: You begin far from a heritage site, come closer at every stop, and
    sign in from inside it.
  FIRST VIEWPORT: Full-bleed dusk horizon, the citadel small enough to miss,
    the river beneath it. Serif title begins at 58% height. A four-segment
    distance rule and one clay action are pinned to the bottom.
  FORM: The Approach; candidate 6 of 7 on the ordered list; seed e13d6c8d.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomChrome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkip"
            style="@style/Widget.EastSyria.Button.Text"
            android:layout_width="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:minWidth="72dp"
            android:text="@string/onboarding_skip"
            android:textColor="@color/ivory"
            app:backgroundTint="#CC221C17"
            app:cornerRadius="24dp"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomChrome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- The distance rule: how far you have come, measured, not dotted. -->
        <LinearLayout
            android:id="@+id/distanceRule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <View
                android:id="@+id/ruleSeg1"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@color/clay" />

            <View
                android:id="@+id/ruleSeg2"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@color/hairline" />

            <View
                android:id="@+id/ruleSeg3"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@color/hairline" />

            <View
                android:id="@+id/ruleSeg4"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/hairline" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartJourney"
            style="@style/Widget.EastSyria.Button.Primary"
            android:layout_width="match_parent"
            android:text="@string/onboarding_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExploreNearby"
            style="@style/Widget.EastSyria.Button.Text"
            android:layout_width="match_parent"
            android:layout_marginTop="6dp"
            android:textColor="@color/bone_dim"
            android:text="@string/onboarding_open_map" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:visibility="gone"
        android:indeterminateTint="@color/clay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
