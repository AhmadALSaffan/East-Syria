<?xml version="1.0" encoding="utf-8"?>
<!--
  Updates: what changed in the catalog, newest first, grouped into Recent and
  Earlier. Unread rows carry a terracotta dot; "Mark all as read" appears only
  when there is something to mark.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.example.eastsyria.Ui.ScreenHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/updates_title"
        app:showBack="false" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:listitem="@layout/item_notification" />

        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <include layout="@layout/item_notification_skeleton" />

            <include layout="@layout/item_notification_skeleton" />

            <include layout="@layout/item_notification_skeleton" />

            <include layout="@layout/item_notification_skeleton" />

        </LinearLayout>

        <com.example.eastsyria.Ui.StatePanel
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>

    <!-- The dock: four tabs around the map button. -->
    <com.example.eastsyria.Nav.NavDock
        android:id="@+id/navDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
