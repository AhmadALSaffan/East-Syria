<?xml version="1.0" encoding="utf-8"?>
<!-- A real tag from landmark.tags: a quiet pill on surface, not an action. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MaterialComponents.Chip.Entry"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:clickable="false"
    android:textColor="@color/ivory_dim"
    android:textSize="13sp"
    app:chipBackgroundColor="@color/surface"
    app:chipCornerRadius="18dp"
    app:chipEndPadding="12dp"
    app:chipMinHeight="36dp"
    app:chipStartPadding="12dp"
    app:chipStrokeColor="@color/line"
    app:chipStrokeWidth="1dp"
    app:closeIconVisible="false"
    app:ensureMinTouchTargetSize="false" />
