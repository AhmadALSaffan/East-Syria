<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:id="@+id/scrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="48dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_icon_chip"
                android:tint="@color/ivory"
        android:padding="12dp"
        android:contentDescription="@string/search_back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_edit_title"
                android:textColor="@color/ivory"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
        android:fontFamily="@font/amiri"
        android:includeFontPadding="false"
        android:lineHeight="32sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_badge"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>

        </LinearLayout>

        <!-- General Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_margin="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_general"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_name_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNameEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_name_en"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etNameAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_name_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etNameAr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_name_ar"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:gravity="start"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etCategoryEn"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_cat_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCategoryEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_cat_en"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etCategoryAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_cat_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCategoryAr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_cat_ar"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:gravity="end"
                android:imeOptions="actionNext"
        android:textSize="16sp"/>

        </LinearLayout>

        <!-- Landmark Narrative -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_narrative"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_short_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescriptionEn"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_short_en"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etDescriptionAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_short_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etDescriptionAr"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_short_ar"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etLongDescriptionEn"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_long_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLongDescriptionEn"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_long_en"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etLongDescriptionAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_long_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etLongDescriptionAr"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_long_ar"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:layout_marginTop="4dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:imeOptions="actionNext"
        android:textSize="16sp"/>

        </LinearLayout>

        <!-- Media Assets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_photo"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPickImage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/admin_change_image"
                android:textColor="@color/ivory"
                android:backgroundTint="@color/surface"
                android:layout_marginBottom="8dp"
        android:textAllCaps="false"/>

            <TextView
                android:id="@+id/tvImageHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_keep_image"
                android:textColor="@color/ivory_mute"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@color/surface" />

        </LinearLayout>

        <!-- Geographic Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_place"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_city_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCityEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_city_en"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etCityAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_city_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etCityAr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_city_ar"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:gravity="start"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etGovernorateEn"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_gov_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etGovernorateEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_gov_en"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etGovernorateAr"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_gov_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etGovernorateAr"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_gov_ar"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:gravity="start"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etRegionEn"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_region"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etRegionEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_region"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etLatitude"
        android:textSize="16sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_f_lat"
                        android:textColor="@color/ivory_dim"
                        android:textSize="14sp"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etLatitude"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/dash_bg_dark"
                        android:textColor="@color/ivory"
                        android:textColorHint="@color/ivory_mute"
                        android:hint="@string/admin_h_lat"
                        android:paddingHorizontal="12dp"
                        android:layout_marginTop="4dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
                        android:nextFocusDown="@id/etLongitude"
        android:textSize="16sp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_f_lng"
                        android:textColor="@color/ivory_dim"
                        android:textSize="14sp"/>

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etLongitude"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/dash_bg_dark"
                        android:textColor="@color/ivory"
                        android:textColorHint="@color/ivory_mute"
                        android:hint="@string/admin_h_lng"
                        android:paddingHorizontal="12dp"
                        android:layout_marginTop="4dp"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionNext"
        android:textSize="16sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Historical Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_history"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_year"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etYearBuilt"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_year"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etBuiltBy"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_builder"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBuiltBy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_builder"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etEra"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_era"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEra"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_era"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etMaterial"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_material"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etMaterial"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_material"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etElevation"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_elevation"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etElevation"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_elevation"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:imeOptions="actionNext"
        android:textSize="16sp"/>

        </LinearLayout>

        <!-- Logistics & Access -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_visit"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_hours"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etVisitingHours"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_hours"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etEntryFee"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_fee"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEntryFee"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_fee"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etBestTimeToVisit"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_best"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etBestTimeToVisit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_best"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:inputType="text"
                android:imeOptions="actionNext"
        android:textSize="16sp"/>

        </LinearLayout>

        <!-- Status & Meta-tags -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_add"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:fontFamily="sans-serif-medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_s_status"
                android:textColor="@color/ivory"
                android:textSize="18sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_status_en"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etStatus"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_status_en"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:nextFocusDown="@id/etStatusArabic"
        android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_f_status_ar"
                android:textColor="@color/ivory_dim"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etStatusArabic"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/dash_bg_dark"
                android:textColor="@color/ivory"
                android:textColorHint="@color/ivory_mute"
                android:hint="@string/admin_h_status_ar"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:gravity="start"
                android:imeOptions="actionDone"
        android:textSize="16sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_featured"
                    android:textColor="@color/ivory"
                    android:textSize="13sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchFeatured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_trending"
                    android:textColor="@color/ivory"
                    android:textSize="13sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_historical"
                    android:textColor="@color/ivory"
                    android:textSize="13sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHistorical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
        app:thumbTint="@color/switch_thumb"
        app:trackTint="@color/switch_track"/>

            </LinearLayout>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            android:indeterminate="true"
            android:progressTint="@color/terracotta"
            android:progressBackgroundTint="@color/surface" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveLandmark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/admin_save_edit"
            android:textColor="@color/on_accent"
            android:textSize="16sp"
            android:textStyle="normal"
            android:background="@drawable/add_bg_orange"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="70dp" />

    </LinearLayout>

</ScrollView>
