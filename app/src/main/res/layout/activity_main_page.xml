<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, v3 (obsidian / ice / racing red).
  A calm header (greeting, title, avatar), an inline search field, then the
  featured landmarks as inset photo cards, the kinds of place as quiet chips,
  and the trending places as a rail. Red is kept for the one action on each
  card and the active state; everything else is ice on obsidian.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="148dp">

            <!-- ============================ header ============================ -->

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ivory_mute"
                        android:textSize="14sp"
                        tools:text="Good evening" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/amiri"
                        android:includeFontPadding="false"
                        android:text="@string/home_title_explore"
                        android:textColor="@color/ivory"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar"
                    android:clickable="true"
                    android:contentDescription="@string/nav_profile"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/ivory"
                        android:textSize="18sp"
                        tools:text="A" />

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ivory_dim" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_search_hint"
                    android:textColor="@color/ivory_mute"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/btnSearchMap"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/nav_map"
                    android:padding="10dp"
                    android:src="@drawable/ic_map_outlined"
                    app:tint="@color/ivory" />

            </LinearLayout>

            <!-- The AI guide. -->
            <LinearLayout
                android:id="@+id/cardAssistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_row_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_accent"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/on_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/assistant_title"
                        android:textColor="@color/ivory"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/assistant_home_body"
                        android:textColor="@color/ivory_mute"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/ivory_mute" />

            </LinearLayout>

            <!-- People nearby. -->
            <LinearLayout
                android:id="@+id/cardNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_row_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_row_icon"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_people"
                    app:tint="@color/ivory" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/nearby_title"
                        android:textColor="@color/ivory"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvNearbyHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/nearby_home_body"
                        android:textColor="@color/ivory_mute"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvUnreadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_accent"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/on_accent"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/ivory_mute" />

            </LinearLayout>

            <!-- ============================ featured ============================ -->

            <LinearLayout style="@style/Widget.EastSyria.V3.SectionHeader">

                <TextView
                    style="@style/Widget.EastSyria.V3.SectionTitle"
                    android:text="@string/section_featured" />

                <TextView
                    android:id="@+id/tvCatalogCount"
                    style="@style/Widget.EastSyria.V3.SectionMeta"
                    tools:text="9 places" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="440dp"
                android:layout_marginTop="14dp">

                <FrameLayout
                    android:id="@+id/heroSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_skeleton_block"
                    android:importantForAccessibility="no">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <View
                            android:layout_width="220dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_skeleton_bar" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_skeleton_bar" />

                    </LinearLayout>

                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedLandmarks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:listitem="@layout/item_featured_landmark" />

                <LinearLayout
                    android:id="@+id/heroState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_skeleton_block"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvStateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/amiri"
                        android:includeFontPadding="false"
                        android:textColor="@color/ivory"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="Nothing published yet" />

                    <TextView
                        android:id="@+id/tvStateBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/ivory_dim"
                        android:textSize="15sp"
                        tools:text="New landmarks appear here as soon as they are published." />

                    <TextView
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/action_retry"
                        android:textColor="@color/ivory"
                        android:textSize="15sp" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/heroDots"
                android:layout_width="wrap_content"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <!-- ========================== categories ========================== -->

            <LinearLayout style="@style/Widget.EastSyria.V3.SectionHeader">

                <TextView
                    style="@style/Widget.EastSyria.V3.SectionTitle"
                    android:text="@string/home_browse" />

                <TextView
                    android:id="@+id/btnMore"
                    style="@style/Widget.EastSyria.V3.SectionAction"
                    android:text="@string/action_see_all" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnHistorical"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_historical" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_historical" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnNature"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_waves" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_nature" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCulture"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_people" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_culture" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnMuseums"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_museum" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_museums" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCuisine"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_restaurant" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_cuisine" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCrafts"
                        style="@style/Widget.EastSyria.V3.Chip">

                        <ImageView
                            style="@style/Widget.EastSyria.V3.ChipIcon"
                            android:src="@drawable/ic_tools" />

                        <TextView
                            style="@style/Widget.EastSyria.V3.ChipLabel"
                            android:text="@string/cat_crafts" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ============================ trending ============================ -->

            <LinearLayout
                android:id="@+id/sectionTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout style="@style/Widget.EastSyria.V3.SectionHeader">

                    <TextView
                        style="@style/Widget.EastSyria.V3.SectionTitle"
                        android:text="@string/section_trending" />

                    <TextView
                        android:id="@+id/tvViewMap"
                        style="@style/Widget.EastSyria.V3.SectionAction"
                        android:text="@string/action_view_map" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTrendingDestinations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="20dp"
                    android:paddingEnd="6dp"
                    tools:listitem="@layout/item_trending_destination"
                    tools:orientation="horizontal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/trendingSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:importantForAccessibility="no"
                android:orientation="horizontal"
                android:paddingStart="20dp">

                <View
                    android:layout_width="236dp"
                    android:layout_height="300dp"
                    android:background="@drawable/bg_skeleton_block" />

                <View
                    android:layout_width="236dp"
                    android:layout_height="300dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_skeleton_block" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- A solid strip behind the status bar once the header has scrolled away. -->
    <View
        android:id="@+id/topBarBg"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:background="@color/canvas"
        android:importantForAccessibility="no" />

    <com.example.eastsyria.Nav.NavDock
        android:id="@+id/navDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
