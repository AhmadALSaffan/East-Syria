<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: The home screen opens on a place, not a form. A full-bleed
    photograph of a featured landmark fills the first viewport; search floats
    over it. It refuses the header-plus-search-plus-icon-grid opening every
    catalog app ships.
  OWN-WORLD: Warm basalt canvas (#16120F), ivory type, terracotta acts, gold
    marks a rating, teal is the map and nothing else. Amiri carries names in
    Latin and Arabic; Roboto carries the interface. Photographs melt into the
    canvas through scrims; nothing is boxed around them.
  STORY: You arrive, a landmark is already looking back at you, you tap it or
    reach for search, a category, or the map.
  FIRST VIEWPORT: 480dp hero (name, Arabic name, place, one action, page
    dots) under a floating search pill; the category row peeks beneath it;
    a pill navigation floats above the foot with the map as its own button.
  FORM: Photo-led hero carousel; user-pinned direction (no roll).
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- ============================== content ============================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="176dp">

            <!-- ============================ hero ============================ -->

            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="480dp">

                <!-- Loading: the hero's own silhouette, pulsing. -->
                <FrameLayout
                    android:id="@+id/heroSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_skeleton_hero"
                    android:importantForAccessibility="no">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="72dp">

                        <View
                            android:layout_width="260dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_skeleton_bar" />

                        <View
                            android:layout_width="180dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_skeleton_bar" />

                        <View
                            android:layout_width="156dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="22dp"
                            android:background="@drawable/bg_skeleton_bar" />

                    </LinearLayout>

                </FrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedLandmarks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:listitem="@layout/item_featured_landmark" />

                <LinearLayout
                    android:id="@+id/heroDots"
                    android:layout_width="wrap_content"
                    android:layout_height="6dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="36dp"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal" />

                <!-- Empty and error share one panel; the copy changes, the shape does not. -->
                <LinearLayout
                    android:id="@+id/heroState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_empty"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="64dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvStateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/amiri"
                        android:includeFontPadding="false"
                        android:lineHeight="38sp"
                        android:textColor="@color/ivory"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        tools:text="Nothing published yet" />

                    <TextView
                        android:id="@+id/tvStateBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/ivory_dim"
                        android:textSize="15sp"
                        tools:text="New landmarks appear here as soon as they are published." />

                    <TextView
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_hero_button_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="@string/action_retry"
                        android:textColor="@color/terracotta_soft"
                        android:textSize="15sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- ========================== categories ========================== -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnHistorical"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_historical" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_historical" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnNature"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_waves" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_nature" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCulture"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_people" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_culture" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnMuseums"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_museum" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_museums" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCuisine"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_restaurant" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_cuisine" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnCrafts"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout style="@style/Widget.EastSyria.HomeCategoryBox">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_tools" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_crafts" />

                    </LinearLayout>

                    <!-- The index, not a category: outlined, so it reads as a different kind of thing. -->
                    <LinearLayout
                        android:id="@+id/btnMore"
                        style="@style/Widget.EastSyria.HomeCategory">

                        <FrameLayout
                            style="@style/Widget.EastSyria.HomeCategoryBox"
                            android:background="@drawable/bg_category_tile_all">

                            <ImageView
                                style="@style/Widget.EastSyria.HomeCategoryIcon"
                                android:src="@drawable/ic_grid"
                                android:tint="@color/ivory_dim" />

                        </FrameLayout>

                        <TextView
                            style="@style/Widget.EastSyria.HomeCategoryLabel"
                            android:text="@string/cat_all" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- ============================ trending ============================ -->

            <LinearLayout
                android:id="@+id/sectionTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout style="@style/Widget.EastSyria.HomeSectionHeader">

                    <TextView
                        style="@style/Widget.EastSyria.HomeSectionTitle"
                        android:text="@string/section_trending" />

                    <View style="@style/Widget.EastSyria.HomeSectionRule" />

                    <TextView
                        android:id="@+id/tvViewMap"
                        style="@style/Widget.EastSyria.HomeSectionAction"
                        android:text="@string/action_view_map" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTrendingDestinations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_trending_destination" />

            </LinearLayout>

            <!-- Loading: two card silhouettes under the section's own title. -->
            <LinearLayout
                android:id="@+id/trendingSkeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <View
                    android:layout_width="132dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_skeleton_bar" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_skeleton_block" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_skeleton_block" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCatalogCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/ivory_mute"
                android:textSize="13sp"
                tools:text="12 places catalogued" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================ floating search ============================ -->

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <!-- Height is set in code (status bar inset + 76dp); a match_parent
             backing inside this wrap_content bar swallowed the whole screen. -->
        <View
            android:id="@+id/topBarBg"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:alpha="0"
            android:background="@drawable/bg_top_bar_solid"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/searchPill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_pill"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/terracotta_soft" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_search_hint"
                android:textColor="@color/ivory_dim"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- The dock: four tabs around the map button. -->
    <com.example.eastsyria.Nav.NavDock
        android:id="@+id/navDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
