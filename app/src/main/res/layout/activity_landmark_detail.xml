<?xml version="1.0" encoding="utf-8"?>
<!--
  THESIS: The landmark is the first thing on screen and everything you need to
    go is one thumb away. The photograph runs full-bleed and melts into the
    canvas; the name sits on the melt, exactly as on the home hero, and the
    one filled action floats at the foot so directions are never a scroll away.
  OWN-WORLD: Warm canvas (#0B0C0E), ivory type, terracotta acts, gold marks the
    rating, Amiri carries the name in both scripts. Controls float as round
    chips over the photograph; facts are a label-and-value register, not tiles.
  STORY: You see the place, read what it is in your language of choice, check
    the practical facts, and go.
  FIRST VIEWPORT: 500dp photograph under three floating chips; the name, the
    other-script name, category and place, and rating on the melt; the
    directions pill at the foot.
  FORM: Same world as the home hero; user-pinned direction (no roll).
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
    finish review, the verdict, and DESIGN.md
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- ============================== content ============================== -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============================ the object ============================ -->

            <FrameLayout
                android:id="@+id/heroContainer"
                android:layout_width="match_parent"
                android:layout_height="500dp">

                <ImageView
                    android:id="@+id/ivHeroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#14000000"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="top"
                    android:background="@drawable/scrim_canvas_top"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/scrim_canvas_bottom"
                    android:importantForAccessibility="no" />

                <!-- Loading: the hero's own silhouette, pulsing. -->
                <FrameLayout
                    android:id="@+id/heroSkeleton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_skeleton_hero"
                    android:importantForAccessibility="no">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="28dp">

                        <View
                            android:layout_width="280dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_skeleton_bar" />

                        <View
                            android:layout_width="180dp"
                            android:layout_height="26dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_skeleton_bar" />

                        <View
                            android:layout_width="220dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_skeleton_bar" />

                    </LinearLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/heroLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp">

                    <TextView
                        android:id="@+id/tvLandmarkName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/amiri"
                        android:includeFontPadding="false"
                        android:lineHeight="46sp"
                        android:textColor="@color/ivory"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="Tell Halaf" />

                    <TextView
                        android:id="@+id/tvArabicName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/amiri"
                        android:includeFontPadding="false"
                        android:lineHeight="36sp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/ivory_dim"
                        android:textDirection="anyRtl"
                        android:textSize="26sp"
                        tools:text="تل حلف" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.1"
                            android:maxLines="2"
                            android:textColor="@color/ivory_dim"
                            android:textSize="15sp"
                            tools:text="Archaeological · Near Ras al-Ayn, Al-Hasakah Governorate" />

                        <LinearLayout
                            android:id="@+id/layoutRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_star"
                                app:tint="@color/gold" />

                            <TextView
                                android:id="@+id/tvRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/gold"
                                android:textSize="15sp"
                                tools:text="4.5" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- ============================ the reading =========================== -->

            <LinearLayout
                android:id="@+id/contentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="148dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_segment_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnglish"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:text="@string/detail_lang_english"
                        android:textAllCaps="false"
                        android:textColor="@color/ivory"
                        android:textSize="16sp"
                        app:backgroundTint="@color/surface_high"
                        app:cornerRadius="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArabic"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0"
                        android:text="@string/detail_lang_arabic"
                        android:textAllCaps="false"
                        android:textColor="@color/ivory_dim"
                        android:textSize="16sp"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="22dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:lineSpacingExtra="7dp"
                    android:textColor="@color/ivory_dim"
                    android:textDirection="anyRtl"
                    android:textSize="16sp"
                    tools:text="Tell Halaf is one of the most significant archaeological sites in the Near East, dating back to the 6th millennium BCE." />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tagGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="24dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <!-- ============================ the record =========================== -->

                <LinearLayout
                    android:id="@+id/recordSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EastSyria.V3.GroupLabel"
                        android:layout_marginTop="32dp"
                        android:text="@string/detail_section_record" />

                    <LinearLayout
                        android:id="@+id/recordTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_group"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/visitSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EastSyria.V3.GroupLabel"
                        android:layout_marginTop="32dp"
                        android:text="@string/detail_section_visiting" />

                    <LinearLayout
                        android:id="@+id/visitTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_group"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================ missing / error ============================ -->

    <LinearLayout
        android:id="@+id/stateView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineHeight="34sp"
            android:textColor="@color/ivory"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Couldn't load this landmark" />

        <TextView
            android:id="@+id/tvStateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ivory_dim"
            android:textSize="15sp"
            tools:text="Check your connection, then try again." />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_hero_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/action_retry"
            android:textColor="@color/terracotta_soft"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- ============================ floating controls ============================ -->

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <!-- Height is set in code (status bar inset + 64dp); a match_parent
             backing inside this wrap_content bar swallows the whole screen. -->
        <View
            android:id="@+id/topBarBg"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:alpha="0"
            android:background="@drawable/bg_top_bar_solid"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/barRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_photo_button"
                android:contentDescription="@string/detail_back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:tint="@color/photo_icon" />

            <!-- The name, once the hero's own has scrolled beneath the bar. -->
            <TextView
                android:id="@+id/tvBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:alpha="0"
                android:ellipsize="end"
                android:fontFamily="@font/amiri"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/ivory"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Tell Halaf" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_photo_button"
                android:contentDescription="@string/detail_share"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                app:tint="@color/photo_icon" />

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_photo_button"
                android:contentDescription="@string/detail_bookmark"
                android:padding="12dp"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/photo_icon" />

        </LinearLayout>

    </FrameLayout>

    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_canvas_bottom_solid"
        android:importantForAccessibility="no" />

    <!-- The one filled action. It floats so directions are never a scroll away. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetDirections"
        style="@style/Widget.EastSyria.Button.Pill"
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/detail_directions"
        app:elevation="8dp"
        app:icon="@drawable/ic_directions"
        app:iconGravity="textStart"
        app:iconSize="20dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
