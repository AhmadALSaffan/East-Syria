<?xml version="1.0" encoding="utf-8"?>
<!--
  Saved: the places you kept, newest first. The same dense row as search, with
  the bookmark in place of the chevron so removing a place is one tap (and one
  Undo). Every state a list can be in has a face: loading, empty, signed out,
  failed, and a search with no match.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.example.eastsyria.Ui.ScreenHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerTitle="@string/saved_title"
        app:showBack="false" />

    <LinearLayout
        android:id="@+id/searchPill"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/terracotta_soft" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/saved_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/ivory"
            android:textColorHint="@color/ivory_mute"
            android:textSize="15sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/ivory_mute"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="3 saved"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedLandmarks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone"
            tools:listitem="@layout/item_search_result" />

        <LinearLayout
            android:id="@+id/loadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

            <include layout="@layout/item_search_skeleton" />

        </LinearLayout>

        <com.example.eastsyria.Ui.StatePanel
            android:id="@+id/statePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>

    <!-- The dock: four tabs around the map button. -->
    <com.example.eastsyria.Nav.NavDock
        android:id="@+id/navDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>
