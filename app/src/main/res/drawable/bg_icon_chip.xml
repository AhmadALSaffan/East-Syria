<?xml version="1.0" encoding="utf-8"?>
<!-- A round 48dp control floating over a photograph or the canvas. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E2703A">
    <item>
        <shape android:shape="oval">
            <solid android:color="#CC221C17" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
        </shape>
    </item>
</ripple>
