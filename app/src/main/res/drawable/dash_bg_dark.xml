<?xml version="1.0" encoding="utf-8"?>
<!--
  A field inside a form section. It sits one step above the section, and takes a
  terracotta edge while it has the cursor, so you always know where you are.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <stroke
                android:width="2dp"
                android:color="@color/terracotta" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_high" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
