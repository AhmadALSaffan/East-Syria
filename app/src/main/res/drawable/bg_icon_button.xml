<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp round tap target for back. Supplements the system Back gesture. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E2703A">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/basalt_raised" />
            <stroke
                android:width="1dp"
                android:color="@color/hairline" />
        </shape>
    </item>
</ripple>
