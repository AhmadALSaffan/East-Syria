<?xml version="1.0" encoding="utf-8"?>
<!-- The ring the map button sits in: the canvas colour, so it reads as a notch in the bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/canvas" />
    <stroke
        android:width="1dp"
        android:color="@color/line" />
</shape>
