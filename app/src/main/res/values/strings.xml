    <!-- About -->
    <string name="about_intro">East Syria is a bilingual guide to the heritage of eastern Syria: the fortresses, ancient cities, rivers, museums, kitchens and workshops that carry the region\'s history.</string>
    <string name="about_inside_title">What is inside</string>
    <string name="about_inside_body">Every landmark has a written record in Arabic and English, photographs, the practical facts for a visit (hours, entry and the best time to go) and its place on the map. Save the ones you mean to visit and you will hear when new sites are added.</string>
    <string name="about_care_title">How entries are made</string>
    <string name="about_care_body">Landmarks are written and reviewed by the curators before they are published. If something is wrong or missing, tell us and we will correct it.</string>
    <string name="about_credits_title">Photo credits</string>
    <string name="about_credits_body">Mari, Zimri-Lim palace: Heretiq, CC BY-SA 2.5, via Wikimedia Commons. Other photographs belong to the East Syria project.</string>
    <string name="about_contact">Made by</string>
    <string name="about_made_by">Ahmad Al Saffan on GitHub</string>

    <!-- Privacy -->
    <string name="privacy_intro">This explains what East Syria keeps about you and why. In short: only what the app needs to give you an account and your saved places.</string>
    <string name="privacy_collect_title">What we collect</string>
    <string name="privacy_collect_body">Your name and email address, and if you add them, your phone number, your city and a profile photo. We also keep the landmarks you save and the updates sent to you. If you sign in with Google, we receive your name and email from Google.</string>
    <string name="privacy_store_title">Where it is kept</string>
    <string name="privacy_store_body">Your account and saved places are stored with Google Firebase. Profile photos and landmark photos are stored with Supabase. Both keep the data on secured servers; the app talks to them over encrypted connections.</string>
    <string name="privacy_share_title">Who can see it</string>
    <string name="privacy_share_body">Only you can read your account details and saved places. The curators who run the app can see the list of accounts to send updates. We do not sell your data or share it with advertisers, and the app shows no ads.</string>
    <string name="privacy_choices_title">Your choices</string>
    <string name="privacy_choices_body">You can change your details and photo in Personal details at any time. To delete your account and everything stored with it, contact us through the project page in About, and it will be removed.</string>
    <string name="privacy_updated">Last updated November 2026.</string>

